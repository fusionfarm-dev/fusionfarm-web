Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On
# DreamHost must have a valid HTTPS certificate before upload.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.fusionfarm\.net$ [NC]
RewriteRule ^ https://fusionfarm.net%{REQUEST_URI} [R=301,L]
# Serve directory-backed pages at the approved canonical paths without a slash.
RewriteCond %{THE_REQUEST} \s/+(contact|assets|privacy)/[\s?] [NC]
RewriteRule ^(contact|assets|privacy)/$ /$1 [R=301,L]
RewriteRule ^(contact|assets|privacy)$ $1/index.html [END]
# Keep tools, tests and repository metadata inaccessible if accidentally uploaded.
RewriteRule ^(?:tools|tests|\.git|\.openai)(?:/|$) - [F,L]
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-XNxu/9aCf0hVZJn2gpDqSgmq4Ugz6EbHdkaxQZW9V/o=' https://challenges.cloudflare.com; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
